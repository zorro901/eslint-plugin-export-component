{
  "author": {
    "name": "zorro901",
    "url": "https://github.com/zorro901"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "description": "ESLint plugin for making your code easier to read",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/jest": "30.0.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint-plugin-n": "18.5.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsup": "9.0.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "lint",
    "code-style",
    "typescript",
    "eslint",
    "react",
    "react-hooks",
    "hooks",
    "eslint-plugin",
    "eslintplugin"
  ],
  "lint-staged": {
    "*.{ts,tsx,json,md}": "prettier --ignore-unknown --write",
    "*.{ts,tsx}": "eslint --cache --fix"
  },
  "license": "Apache-2.0",
  "name": "eslint-plugin-export-component",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zorro901/eslint-plugin-export-component.git"
  },
  "scripts": {
    "build": "tsup src/lib/index.ts --format cjs,esm --dts --clean",
    "build:dist": "tsc --noEmit && bun run build --minify",
    "build:watch": "bun run build --watch",
    "clean": "bunx rimraf dist",
    "format:check": "prettier src/**/* --ignore-unknown --check",
    "format:fix": "prettier src/**/* --ignore-unknown --write",
    "lint": "eslint \"src/lib/**/*.{ts,tsx}\"",
    "lint:fix": "bun run lint --fix",
    "prepare": "husky",
    "semantic-release": "semantic-release",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:watch:all": "jest --watchAll",
    "preinstall": "npx only-allow bun"
  },
  "version": "0.0.0-alpha.4",
  "dependencies": {
    "@typescript-eslint/parser": "^8.71.2"
  }
}
